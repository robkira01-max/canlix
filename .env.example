# Canlix SaaS — environment variables
# Copy to .env and fill in values before running.

# PostgreSQL connection string.
# Leave unset to use the in-memory store (unit tests, local CLI).
CANLIX_DATABASE_URL=postgresql://canlix:canlix@localhost:5435/canlix

# Trust X-Forwarded-For from reverse proxy (Caddy, nginx).
# Set to 1 only when the proxy unconditionally overwrites XFF before forwarding.
CANLIX_TRUST_PROXY=0
